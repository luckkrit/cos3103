{
  "name": "slides_src",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "slidev build",
    "dev": "slidev --open",
    "cos3103": "slidev cos3103 --open",
    "export": "slidev export",
    "build_sql_select": "slidev build --base /cos3103/slides/sql_select/ --out ../public/slides/sql_select",
    "export_sql_select": "slidev export --with-clicks --format pptx --output ./slides-export/sql_select",
    "build_sql_storedproc_views": "slidev build --base /cos3103/slides/sql_storedproc_views/ --out ../public/slides/sql_storedproc_views",
    "export_sql_storedproc_views": "slidev export --with-clicks --format pptx --output ./slides-export/sql_storedproc_views",
    "build_sql_python_csharp": "slidev build --base /cos3103/slides/sql_python_csharp/ --out ../public/slides/sql_python_csharp",
    "export_sql_python_csharp": "slidev export --with-clicks --timeout 60000 --wait 30000 --format pdf --output ./slides-export/sql_python_csharp",
    "build_sql_transaction": "slidev build --base /cos3103/slides/sql_python_csharp/ --out ../public/slides/sql_transaction",
    "export_sql_transaction": "slidev export --with-clicks --timeout 60000 --wait 30000 --format pdf --output ./slides-export/sql_transaction",
    "build_nosql_tutorial": "slidev build --base /cos3103/slides/nosql_tutorial/ --out ../public/slides/nosql_tutorial",
    "export_nosql_tutorial": "slidev export --with-clicks --timeout 60000 --wait 30000 --format pdf --output ./slides-export/nosql_tutorial",
    "export_nosql_tutorial2": "slidev export --with-clicks --timeout 60000 --wait 30000 --format pdf --output ./slides-export/nosql_tutorial2",
    "clean_nosql_tutorial": "del-cli -f ../public/slides/nosql_tutorial",
    "clean_build_nosql_tutorial": "concurrently \"npm run clean_nosql_tutorial\" \"npm run build_nosql_tutorial\"",
    "build_sql_dml": "slidev build cos3103 --base /cos3103/slides/2_68/sql_dml --out ../public/slides/2_68/sql_dml",
    "clean_sql_dml": "del-cli -f ../public/slides/2_68/sql_dml",
    "export_sql_dml": "slidev export cos3103 --with-clicks --timeout 60000 --wait 60000 --format pdf --output ./slides-export/sql_dml",
    "clean_build_sql_dml": "concurrently \"npm run clean_sql_dml\" \"npm run build_sql_dml\""
  },
  "dependencies": {
    "@slidev/cli": "^52.2.4",
    "@slidev/theme-default": "latest",
    "@slidev/theme-seriph": "latest",
    "slidev-component-zoom": "^1.1.0",
    "slidev-theme-neversink": "^0.4.0",
    "vue": "^3.5.18"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "del-cli": "^7.0.0",
    "playwright-chromium": "^1.54.1"
  }
}